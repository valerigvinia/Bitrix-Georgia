# Public site URL; replace deliberately when the domain is migrated.
NEXT_PUBLIC_SITE_URL=https://bitrix-georgia.vercel.app
# Server-only content source; move to the CMS hostname before switching DNS.
WORDPRESS_API_BASE_URL=https://bitrixgeorgia.ge/wp-json/wp/v2/
# Optional 32+ character secret shared with the WordPress webhook.
# Never use a NEXT_PUBLIC_ prefix for this value. 5-minute request-driven refresh works without it.
WORDPRESS_REVALIDATE_SECRET=
